FROM pws-lab-runtime:0.1.0
RUN apt-get update -o APT::Update::Error-Mode=any && \
    apt-get install -y --no-install-recommends libzmq5 libboost-program-options1.83.0 libconfig++9v5 && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /lab
COPY controller /lab/controller
COPY configs /lab/configs
COPY dependencies.lock.json LICENSE THIRD_PARTY_NOTICES.md /lab/
COPY licenses /usr/local/share/pws-lab/licenses
COPY --from=lab_build /bin/srsenb-lte /usr/local/bin/srsenb-lte
COPY --from=lab_build /bin/srsue-lte /usr/local/bin/srsue-lte
COPY --from=lab_build /manifest.json /usr/local/share/pws-lab/build-manifest.json
ENV SRSENB_LTE_BINARY=/usr/local/bin/srsenb-lte SRSUE_LTE_BINARY=/usr/local/bin/srsue-lte
RUN mkdir -p /lab/output && chown 10001:10001 /lab/output
USER 10001:10001
STOPSIGNAL SIGTERM
ENTRYPOINT ["python", "-m", "controller.lte_sib12"]
CMD ["receive", "--output", "/lab/output/lte-sib12"]
