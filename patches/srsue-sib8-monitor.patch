+  if (std::getenv("PWS_LAB_SI_MONITOR") != nullptr) {
+    const auto& common = sib1.serving_cell_cfg_common.dl_cfg_common.init_dl_bwp.pdcch_cfg_common.setup();
+    if (common.search_space_other_sys_info_present && common.search_space_other_sys_info < SRSRAN_UE_DL_NR_MAX_NOF_SEARCH_SPACE) {
+      auto& search = phy_cfg.pdcch.search_space[common.search_space_other_sys_info];
+      search.type = srsran_search_space_type_common_0A;
+      search.nof_formats = 1;
+      search.formats[0] = srsran_dci_format_nr_1_0;
+      logger.info("LAB_SI searchSpaceOtherSystemInformation=%u", unsigned(common.search_space_other_sys_info));
+    }
+  }
+
   // Apply Carrier Config
   fill_phy_carrier_cfg(sib1.serving_cell_cfg_common, &phy_cfg.carrier);
 
